# Optional. Without this key, assumption extraction uses heuristics only (demo still works).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# heuristic (default, free) | nemotron (opt-in paid NIM call; soft-fails to heuristic)
# WCE_REASONER=openai|nemotron|heuristic (unset: openai if OPENAI_API_KEY, else heuristic)
# WCE_OPENAI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=
WCE_NEMOTRON_PROFILE=fast
# WCE_NEMOTRON_CACHE=off

# Absolute path to a local Pulseboard git checkout for live `git blame -L`.
# We never clone remotes. Auto-tried if unset: /workspace/open-agent/pulseboard,
# /workspace/pulseboard, /workspace/uploads/pulseboard, /tmp/pulseboard.
# As of Fri Oct 23 PT none of those exist on the box → fixture blame is labeled.
WCE_PULSEBOARD_GIT=

# Absolute path to a Cursor cloud-agent transcript JSONL (defaults to Pulseboard builder)
WCE_TRANSCRIPT=

# Lesson store directory (defaults to ./data)
WCE_DATA_DIR=

# In-process Meterless H-MEM directory (default: data/meterless). No network service.
# WCE_METERLESS_DIR=
# Obsolete HTTP-bridge settings. Current code does not read them:
# WCE_METERLESS=
# WCE_METERLESS_URL=
# WCE_METERLESS_NS=
# WCE_METERLESS_BRIDGE_DIR=

# "explain why" stage (src/explain/): the tool's own account of what the coding agent overlooked, backed by
# verified quotes. Default reasoner is NVIDIA Nemotron (above). Anthropic is an opt-in alternative:
# WCE_EXPLAIN_PROVIDER=nemotron|anthropic   (default: nemotron)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=                           # default: claude-sonnet-4-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# WCE_EXPLAIN_CONTEXT_MAX_CHARS=16000         # context builder's token budget (char proxy)

# Zetaris (secrets/ only — never commit password)
# Connection JSON + password live under ./secrets/ (gitignored).
# WCE_ZETARIS=1          # force membership prove SQL + NY_TAXI ping outside demos
# ZETARIS_PASSWORD=      # optional override of secrets/zetaris-admin-password.txt
