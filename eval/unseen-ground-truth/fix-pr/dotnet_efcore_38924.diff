+            contextFactory,
+            async context =>
+            {
+                var g1 = await context.Set<WorkItemGroup38917>()
+                    .Include(g => g.Color)
+                    .SingleAsync(g => g.Name == "G1");
+
+                var c0 = new RgbColor38917 { Id = "0x9a79e4" };
